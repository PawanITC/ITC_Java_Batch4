{
  "realm": "linkedin-app",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,

  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "roles": {
    "realm": [
      { "name": "USER" },
      { "name": "RECRUITER" },
      { "name": "ADMIN" },
      { "name": "COMPANY_ADMIN" },
      { "name": "PREMIUM_USER" },
      { "name": "MODERATOR" }
    ]
  },

  "defaultRoles": ["USER"],

  "groups": [
    { "name": "users", "realmRoles": ["USER"] },
    { "name": "recruiters", "realmRoles": ["RECRUITER"] },
    { "name": "admins", "realmRoles": ["ADMIN"] },
    { "name": "company-admins", "realmRoles": ["COMPANY_ADMIN"] },
    { "name": "premium-users", "realmRoles": ["PREMIUM_USER"] },
    { "name": "moderators", "realmRoles": ["MODERATOR"] }
  ],

  "clients": [
    {
      "clientId": "linkedin-frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "api-gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ]
}