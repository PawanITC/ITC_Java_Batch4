{
  "realm": "linkedin-app",
  "enabled": true,

  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,

  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "roles": {
    "realm": [
      { "name": "USER" },
      { "name": "RECRUITER" },
      { "name": "ADMIN" },
      { "name": "COMPANY_ADMIN" },
      { "name": "PREMIUM_USER" },
      { "name": "MODERATOR" }
    ]
  },

  "defaultRoles": ["USER"],

  "groups": [
    { "name": "users", "realmRoles": ["USER"] },
    { "name": "recruiters", "realmRoles": ["RECRUITER"] },
    { "name": "admins", "realmRoles": ["ADMIN"] },
    { "name": "company-admins", "realmRoles": ["COMPANY_ADMIN"] },
    { "name": "premium-users", "realmRoles": ["PREMIUM_USER"] },
    { "name": "moderators", "realmRoles": ["MODERATOR"] }
  ],

  "clients": [
    {
      "clientId": "linkedin-frontend",
      "name": "LinkedIn Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://*.eu-west-2.elb.amazonaws.com/*",
        "https://*.eu-west-2.elb.amazonaws.com/*",
        "http://localhost:8086/swagger-ui/oauth2-redirect.html",
        "http://localhost:8087/swagger-ui/oauth2-redirect.html",
        "http://localhost:8083/swagger-ui/oauth2-redirect.html",
        "http://localhost:8085/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://*.eu-west-2.elb.amazonaws.com",
        "https://*.eu-west-2.elb.amazonaws.com",
        "http://localhost:8086",
        "http://localhost:8087",
        "http://localhost:8083",
        "http://localhost:8085"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/* http://*.eu-west-2.elb.amazonaws.com/* https://*.eu-west-2.elb.amazonaws.com/*"
      },
      "protocolMappers": [
        {
          "name": "keycloak-user-id-sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "api-gateway",
      "name": "API Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],

  "users": [
    {
      "username": "user.demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "user.demo@example.com",
      "realmRoles": ["USER"],
      "credentials": [
        {
          "type": "password",
          "value": "Password123",
          "temporary": false
        }
      ]
    },
    {
      "username": "recruiter.demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Recruiter",
      "email": "recruiter.demo@example.com",
      "realmRoles": ["RECRUITER"],
      "credentials": [
        {
          "type": "password",
          "value": "Password123",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin.demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "email": "admin.demo@example.com",
      "realmRoles": ["ADMIN"],
      "credentials": [
        {
          "type": "password",
          "value": "Password123",
          "temporary": false
        }
      ]
    }
  ]
}
