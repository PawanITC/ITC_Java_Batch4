SPRING_PROFILES_ACTIVE=prod

KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/linkedin-app
KEYCLOAK_JWK_SET_URI=https://auth.example.com/realms/linkedin-app/protocol/openid-connect/certs

GATEWAY_ALLOWED_ORIGIN=https://app.example.com
GATEWAY_ALLOWED_TOKEN_CLIENT=linkedin-frontend
GATEWAY_ADDITIONAL_ALLOWED_TOKEN_CLIENT=api-gateway
GATEWAY_RATE_LIMIT_REPLENISH_RATE=25
GATEWAY_RATE_LIMIT_BURST_CAPACITY=50
GATEWAY_CONNECT_TIMEOUT_MILLIS=5000
GATEWAY_RESPONSE_TIMEOUT=10s

REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_SSL_ENABLED=true
SPRING_DATA_REDIS_SSL_ENABLED=true

USERPROFILE_SERVICE_URI=http://userprofile-service:8083
SEARCH_SERVICE_URI=http://search-discovery-service:8086
FEED_SERVICE_URI=http://feed-and-timeline-service:8087
POST_SERVICE_URI=http://post-service:8088

USERPROFILE_POSTGRES_URL=jdbc:postgresql://your-rds-endpoint:5432/userprofile
USERPROFILE_POSTGRES_USER=postgres
USERPROFILE_POSTGRES_PASSWORD=change-me

FEED_POSTGRES_URL=jdbc:postgresql://your-rds-endpoint:5432/feeddb
FEED_POSTGRES_USER=postgres
FEED_POSTGRES_PASSWORD=change-me

POSTGRES_URL=jdbc:postgresql://your-rds-endpoint:5432/postdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=require

SPRING_KAFKA_BOOTSTRAP_SERVERS=b-1.your-msk-cluster.amazonaws.com:9098,b-2.your-msk-cluster.amazonaws.com:9098
SPRING_KAFKA_SCHEMA_REGISTRY_URL=https://schema-registry.example.com

ELASTICSEARCH_URI=https://your-domain.eu-west-2.es.amazonaws.com:443
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
SEARCH_SEED_DEMO_DATA=true

SWAGGER_OAUTH_CLIENT_ID=linkedin-frontend
SEARCH_SWAGGER_OAUTH_REDIRECT_URL=https://search.example.com/swagger-ui/oauth2-redirect.html
FEED_SWAGGER_OAUTH_REDIRECT_URL=https://feed.example.com/swagger-ui/oauth2-redirect.html

TIMELINE_SEED_DEMO_DATA=true
TIMELINE_RESET_DEMO_DATA=true
TIMELINE_DEMO_USER_ID=b153813e-ab6d-4e49-8f01-df40055dfd88

REACT_APP_API_BASE_URL=https://api.example.com
REACT_APP_KEYCLOAK_URL=https://auth.example.com
REACT_APP_KEYCLOAK_REALM=linkedin-app
REACT_APP_KEYCLOAK_CLIENT_ID=linkedin-frontend
REACT_APP_LOGOUT_REDIRECT_URI=https://app.example.com/login
